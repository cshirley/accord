# Example secrets file for `bun run smoke:act:autopipeline`.
#
# Copy to `.env.smoke` (gitignored) and fill in. The autopipeline will
# fail at setup-pi with `MISSING_REQUIRED_SECRET: <NAME>` if any of the
# four are unset.
#
# Use throwaway / sandbox values for smoke tests — never paste a real
# production token here.

ANTHROPIC_API_KEY=sk-ant-fake-smoke
JIRA_BASE_URL=https://example.atlassian.net
JIRA_USER_EMAIL=smoke@example.com
JIRA_API_TOKEN=fake-token

# Optional: only needed for cross-repo PR creation (AC-25).
# GH_PAT_PR=ghp_fake_smoke
