{
  "name": "@clive.shirley/pi-accord",
  "version": "0.1.0",
  "description": "ACCORD for pi — agentic contract, briefing, Crucible verification, and rigorous delivery workflow",
  "keywords": ["pi-package"],
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test",
    "validate:schemas": "node schemas/examples/validate-examples.mjs",
    "validate:assets": "bun scripts/validate-assets.ts",
    "install:pi-assets": "bun scripts/install-pi-assets.ts",
    "install:pi-dev": "bash scripts/pi-dev-install.sh",
    "check:bundle": "bun build ./src/index.ts --target=node --outfile=/tmp/accord-check.js --external @mariozechner/pi-ai --external @mariozechner/pi-agent-core --external @mariozechner/pi-coding-agent --external @mariozechner/pi-tui --external typebox",
    "check:types": "tsc --noEmit",
    "check:runtime": "bun scripts/runtime-smoke.ts",
    "mcp": "bun run src/adapters/mcp/server.ts",
    "check": "npm run test && npm run validate:schemas && npm run validate:assets && npm run check:types && npm run check:bundle && npm run check:runtime"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "packages/",
    "assets/",
    "schemas/",
    "scripts/",
    "README.md",
    "AGENTS.md"
  ],
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "^0.73.0",
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@mariozechner/pi-tui": "^0.73.0",
    "typebox": "^1.1.37"
  },
  "pi": {
    "extensions": [
      "./packages/pi-subagent/src/index.ts",
      "./packages/pi-worktree/src/index.ts",
      "./packages/pi-thrift/src/index.ts",
      "./packages/pi-git-tools/src/index.ts",
      "./packages/pi-tools/src/index.ts",
      "./src/index.ts"
    ],
    "skills": [
      "./assets/skills/accord",
      "./assets/skills/dev",
      "./assets/skills/commit",
      "./assets/skills/pr",
      "./assets/skills/review"
    ],
    "agents": [
      "./assets/agents"
    ]
  },
  "accord": {
    "assetManifest": "./assets/manifest.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "ajv": "^8.20.0",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
