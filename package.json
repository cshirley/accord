{
  "name": "@clive.shirley/accord",
  "version": "0.1.0",
  "description": "ACCORD for pi — agentic contract, briefing, Crucible verification, and rigorous delivery workflow",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "validate:schemas": "node packages/accord-core/schemas/examples/validate-examples.mjs",
    "validate:assets": "bun packages/accord-assets/scripts/validate-assets.ts && bun packages/pi-skills/scripts/validate-pi-skills.ts",
    "install:assets": "bun packages/pi-accord/scripts/install-assets.ts",
    "install:assets:force": "bun packages/pi-accord/scripts/install-assets.ts --force",
    "install:shim": "bun packages/accord-cli/scripts/install-shim.ts",
    "install:dev": "bash scripts/install-dev.sh",
    "install:pi-skills": "bash scripts/install-pi-skills.sh",
    "check:bundle": "bun build ./packages/pi-accord/src/index.ts --target=node --outfile=/tmp/accord-check.js --external @earendil-works/pi-ai --external @earendil-works/pi-agent-core --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui --external @clive.shirley/accord-core --external typebox",
    "check:types": "tsc --noEmit",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:runtime": "bun packages/pi-accord/scripts/runtime-smoke.ts",
    "mcp": "bun run packages/accord-mcp/src/server.ts",
    "accord": "bun packages/accord-cli/src/main.ts",
    "check": "npm run test && npm run check:biome && npm run validate:schemas && npm run validate:assets && npm run check:types && npm run check:bundle && npm run check:runtime",
    "smoke:act:self-test": "bun run packages/accord-ci/src/smoke-act.ts pull_request -W .github/workflows/test-autopipeline.yml",
    "smoke:act:autopipeline": "bun run packages/accord-ci/src/smoke-act.ts workflow_dispatch -W .github/workflows/autopipeline-smoke.yml --input ticket=DEMO-1 --input dry_run=true --secret-file .env.smoke",
    "smoke:gh:autopipeline": "bash scripts/smoke-gh-autopipeline.sh"
  },
  "license": "MIT",
  "author": "Clive Shirley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cshirley/accord.git"
  },
  "bugs": {
    "url": "https://github.com/cshirley/accord/issues"
  },
  "homepage": "https://github.com/cshirley/accord#readme",
  "main": "./packages/pi-accord/src/index.ts",
  "files": [
    "packages/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "typebox": "^1.3.7"
  },
  "pi": {
    "extensions": [
      "./packages/pi-subagent/src/index.ts",
      "./packages/pi-thrift/src/index.ts",
      "./packages/pi-git/src/index.ts",
      "./packages/pi-integrations/src/index.ts",
      "./packages/pi-accord/src/index.ts"
    ],
    "skills": [
      "./packages/pi-skills/skills/ci-debug",
      "./packages/pi-skills/skills/commit",
      "./packages/pi-skills/skills/crq-notify",
      "./packages/pi-skills/skills/pr",
      "./packages/pi-skills/skills/review",
      "./packages/pi-skills/skills/session-retro",
      "./packages/pi-skills/skills/verify",
      "./packages/pi-skills/skills/worktree"
    ],
    "agents": [
      "./packages/accord-assets/agents"
    ]
  },
  "accord": {
    "assetManifest": "./packages/accord-assets/manifest.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "ajv": "^8.20.0",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
