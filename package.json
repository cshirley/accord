{
  "name": "@clive.shirley/pi-accord",
  "version": "0.1.0",
  "description": "ACCORD for pi — agentic contract, briefing, Crucible verification, and rigorous delivery workflow",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "validate:schemas": "node schemas/examples/validate-examples.mjs",
    "validate:assets": "bun scripts/validate-assets.ts",
    "install:assets": "bun scripts/install-assets.ts",
    "install:dev": "bash scripts/install-dev.sh",
    "check:bundle": "bun build ./src/index.ts --target=node --outfile=/tmp/accord-check.js --external @earendil-works/pi-ai --external @earendil-works/pi-agent-core --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui --external typebox",
    "check:types": "tsc --noEmit",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:runtime": "bun scripts/runtime-smoke.ts",
    "mcp": "bun run src/adapters/mcp/server.ts",
    "check": "npm run test && npm run check:biome && npm run validate:schemas && npm run validate:assets && npm run check:types && npm run check:bundle && npm run check:runtime",
    "smoke:act:self-test": "bun run scripts/ci/smoke-act.ts pull_request -W .github/workflows/test-autopipeline.yml",
    "smoke:act:autopipeline": "bun run scripts/ci/smoke-act.ts workflow_dispatch -W .github/workflows/autopipeline-smoke.yml --input ticket=DEMO-1 --input dry_run=true --secret-file .env.smoke",
    "smoke:gh:autopipeline": "gh workflow run autopipeline-smoke.yml --ref main -f ticket=DEMO-1 -f dry_run=true"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "packages/",
    "assets/",
    "schemas/",
    "scripts/",
    "README.md",
    "AGENTS.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.75.3",
    "@earendil-works/pi-ai": "^0.75.3",
    "@earendil-works/pi-coding-agent": "^0.75.3",
    "@earendil-works/pi-tui": "^0.75.3",
    "typebox": "^1.1.37"
  },
  "pi": {
    "extensions": [
      "./packages/pi-subagent/src/index.ts",
      "./packages/pi-worktree/src/index.ts",
      "./packages/pi-thrift/src/index.ts",
      "./packages/pi-git-tools/src/index.ts",
      "./packages/pi-tools/src/index.ts",
      "./src/index.ts"
    ],
    "skills": [
      "./assets/skills/accord",
      "./assets/skills/dev",
      "./assets/skills/commit",
      "./assets/skills/pr",
      "./assets/skills/review"
    ],
    "agents": [
      "./assets/agents"
    ]
  },
  "accord": {
    "assetManifest": "./assets/manifest.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "ajv": "^8.20.0",
    "bun-types": "^1.3.13",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
