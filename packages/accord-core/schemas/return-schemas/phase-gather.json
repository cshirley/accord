{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "return-schemas/phase-gather.json",
  "title": "phase-gather return packet",
  "type": "object",
  "required": ["status", "context", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["done", "stuck"]
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "files_mentioned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enrichments_dir": {
      "type": "string",
      "description": "Path to .tasks/<ID>-enrichments/ directory where full enrichment content is cached."
    },
    "enrichments": {
      "type": "array",
      "description": "Lightweight references to cached enrichment content. Full content lives in cache_path files.",
      "items": {
        "type": "object",
        "required": ["source", "status"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "Enrichment source type — e.g. slack, google-docs, confluence, github-pr"
          },
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable", "cached"],
            "description": "ok=freshly fetched, cached=reused from valid cache, unavailable=fetch failed"
          },
          "title": {
            "type": "string",
            "description": "Document/page/discussion title (when applicable)"
          },
          "summary": {
            "type": "string",
            "description": "Concise summary of the enrichment content (kept small for context window)"
          },
          "url": {
            "type": "string",
            "description": "Source URL for the enrichment content"
          },
          "cache_path": {
            "type": "string",
            "description": "Path to the full cached content file in .tasks/<ID>-enrichments/"
          },
          "reason": {
            "type": "string",
            "description": "Explanation when status is unavailable"
          }
        }
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "context_on_stuck": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stuck"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["question", "context_on_stuck"]
      }
    }
  ]
}
