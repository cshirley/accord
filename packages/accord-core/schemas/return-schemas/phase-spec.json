{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "return-schemas/phase-spec.json",
  "title": "phase-spec return packet",
  "type": "object",
  "required": ["status", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["done", "needs_input", "stuck"] },
    "draft": { "type": "object" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "spec_path": { "type": "string", "minLength": 1 },
    "review_findings_remaining": { "type": "integer", "minimum": 0 },
    "question": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "tried": { "type": "string" },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "needs_input" } },
        "required": ["status"]
      },
      "then": { "required": ["draft", "questions"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "done" } },
        "required": ["status"]
      },
      "then": { "required": ["spec_path"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "stuck" } },
        "required": ["status"]
      },
      "then": { "required": ["question", "context"] }
    }
  ]
}
