{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "return-schemas/phase-verify-task.json",
  "title": "phase-verify-task return packet",
  "description": "Return packet for verify-only plan tasks (steps are exclusively tag: verify). No test_files or red_confirmed.",
  "type": "object",
  "required": ["status", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": ["done", "stuck"]
    },
    "evidence": {
      "type": "array",
      "description": "One entry per covered AC. A fail raises a gating finding and loops to phase-code.",
      "items": {
        "type": "object",
        "required": ["ac_id", "result", "tests"],
        "additionalProperties": false,
        "properties": {
          "ac_id": {
            "type": "string"
          },
          "result": {
            "enum": ["pass", "fail"]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Test names / commands that prove (or failed) the AC."
          },
          "command": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "Failure excerpt (fail only)."
          }
        }
      }
    },
    "verify_output": {
      "type": "string",
      "maxLength": 65536,
      "description": "Truncated stdout/stderr from verification commands"
    },
    "ac_covered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AC ids exercised by the verification gate Deprecated — use evidence[]."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "Blocking question (when status=stuck)"
    },
    "context": {
      "type": "string",
      "description": "Context for the blocking question (when status=stuck)"
    },
    "tried": {
      "type": "string",
      "description": "Approaches tried before getting stuck (when status=stuck)"
    },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stuck"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["question", "context"]
      }
    }
  ]
}
