{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spec-schema.json",
  "title": "Spec",
  "type": "object",
  "required": [
    "schema_version",
    "work_item_id",
    "title",
    "date",
    "problem_statement",
    "proposed_solution",
    "acceptance_criteria",
    "scope",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^[A-Z]+(-[A-Z]+)*-\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string"
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1
    },
    "proposed_solution": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirement", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-\\d+$"
          },
          "requirement": {
            "enum": ["MUST", "SHOULD", "MAY"]
          },
          "type": {
            "enum": ["scenario", "constraint", "architectural", "property"]
          }
        },
        "oneOf": [
          {
            "required": ["scenario"],
            "properties": {
              "type": {
                "const": "scenario"
              },
              "scenario": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": ["criterion"],
            "properties": {
              "type": {
                "const": "constraint"
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": ["criterion", "enforcement"],
            "properties": {
              "type": {
                "const": "architectural"
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "enforcement": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": ["criterion"],
            "properties": {
              "type": {
                "const": "property"
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "scope": {
      "type": "object",
      "required": ["in", "out"],
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item", "reason"],
            "additionalProperties": false,
            "properties": {
              "item": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["commands", "test_cases"],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "covers", "scenario"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^TC-\\d+$"
              },
              "covers": {
                "type": "string",
                "pattern": "^AC-\\d+$"
              },
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "enum": ["unit", "integration", "e2e"]
              },
              "test_name_glob": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "infra_and_tooling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monorepo_scaffold": {
          "type": "string"
        },
        "package_manager": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "linter": {
          "type": "string",
          "description": "Linter/formatter choice — e.g. biome, eslint+prettier, ruff, gofmt. Use 'inherit' when adopting the repo default without change."
        },
        "env_validation": {
          "type": "string",
          "description": "Env validation library / approach — e.g. @t3-oss/env-nextjs, zod-custom, envalid, none (explicit opt-out)."
        },
        "coverage_threshold": {
          "type": "string",
          "description": "Coverage gate — numeric percent (e.g. '80') or 'none' when merge is not gated on coverage."
        },
        "ci_in_v1": {
          "type": "boolean",
          "description": "Whether a CI pipeline is delivered as part of this work item. If false, a scope.out entry MUST explain deferral."
        },
        "ci_platform": {
          "type": "string"
        },
        "required_workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security_topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tier"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "enum": ["server-only", "client-safe", "public"]
              },
              "owner": {
                "type": "string"
              },
              "rotation_window": {
                "type": "string"
              }
            }
          }
        },
        "registry_auth": {
          "type": "array",
          "description": "Private package/artifact registries the install or build depends on — each a credential surface that new contributors and CI must provision.",
          "items": {
            "type": "object",
            "required": ["name", "credential", "tier"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Registry or scope — e.g. a GitHub Packages scope, private npm, ghcr.io."
              },
              "credential": {
                "type": "string",
                "minLength": 1,
                "description": "Env var or file providing access — e.g. GITHUB_TOKEN, NPM_TOKEN, GOOGLE_APPLICATION_CREDENTIALS."
              },
              "tier": {
                "enum": ["server-only", "ci-only", "developer"],
                "description": "Where the credential lives. 'developer' means every contributor provisions locally."
              },
              "scope": {
                "type": "string",
                "description": "Optional — what the credential grants read/write access to."
              }
            }
          }
        }
      }
    },
    "dev_ergonomics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_auth_mode": {
          "type": "string"
        },
        "seed_strategy": {
          "type": "string"
        },
        "env_mode_for_verification_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "env_mode"],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "env_mode": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "test_topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_location": {
          "type": "string"
        },
        "e2e_location": {
          "type": "string"
        },
        "storage_state_strategy": {
          "type": "string"
        }
      }
    },
    "telemetry_topology": {
      "type": "object",
      "description": "Logging, metrics, tracing, and alerting requirements for this work item. Populate or justify in scope.out — never leave silent.",
      "additionalProperties": false,
      "properties": {
        "log_events": {
          "type": "array",
          "description": "Structured log events this work item must emit.",
          "items": {
            "type": "object",
            "required": ["event", "level", "fields"],
            "additionalProperties": false,
            "if": {
              "properties": { "fields": { "minItems": 1 } },
              "required": ["fields"]
            },
            "then": {
              "required": ["pii_redaction"]
            },
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1,
                "description": "Stable event name/message, e.g. 'auth.refresh.failed'."
              },
              "level": {
                "enum": ["debug", "info", "warn", "error"]
              },
              "fields": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Structured fields attached to the event \u2014 declare every field even when empty. Any field that is user-identifying, authentication material, or payment data \u2014 not just env-var-shaped secrets \u2014 requires pii_redaction."
              },
              "pii_redaction": {
                "type": "string",
                "minLength": 1,
                "description": "Redaction/masking approach when any field is a secret, PII, or other sensitive data. Required whenever fields[] is non-empty \u2014 use 'none \u2014 no sensitive fields' when nothing needs masking, never leave absent. The sentinel is rejected by review-spec 7k if fields[] actually contains a secret/PII-shaped name."
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "description": "Metrics this work item must emit.",
          "items": {
            "type": "object",
            "required": ["name", "type", "critical_path"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": ["counter", "gauge", "histogram", "timer"]
              },
              "critical_path": {
                "type": "boolean",
                "description": "True when this metric covers a critical operation (per review-code's Observability dimension) — missing instrumentation here is a drift finding, not a style suggestion."
              }
            }
          }
        },
        "trace_propagation": {
          "type": "string",
          "not": { "pattern": "[hH][tT][tT][pP][sS]?://" },
          "description": "Trace/correlation-id propagation strategy naming the inbound-trust boundary and outbound egress boundary (e.g. 'W3C traceparent on internal mesh calls only; stripped at the egress client for third-party APIs; inbound traceparent accepted but never trusted for authz'), or 'none' with justification. Never a credentialed collector URL \u2014 name the collector/env var instead."
        },
        "alerting": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "channel"],
            "additionalProperties": false,
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1,
                "not": { "pattern": "[hH][tT][tT][pP][sS]?://" },
                "description": "Logical destination name or env var holding the endpoint (e.g. '#oncall-auth', 'ALERT_WEBHOOK_URL') \u2014 never an inline webhook URL or routing key."
              }
            }
          }
        }
      }
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "reason", "summary"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "triggered_phase": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "resolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "api_contract": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "description"],
        "additionalProperties": false,
        "properties": {
          "symbol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "jira_context": {
      "type": "string"
    },
    "diagrams": {
      "type": "array",
      "description": "Optional Mermaid diagrams rendered into spec.md (harness-generated). Each diagram must duplicate facts already stated in prose/AC fields — not a second source of requirements.",
      "items": {
        "type": "object",
        "required": ["section", "mermaid"],
        "additionalProperties": false,
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "overview",
              "proposed_solution",
              "scope",
              "verification",
              "security_topology",
              "api_contract",
              "deployment"
            ],
            "description": "Where the diagram appears in spec.md relative to rendered sections."
          },
          "caption": {
            "type": "string",
            "description": "Optional short label shown above the diagram in spec.md."
          },
          "mermaid": {
            "type": "string",
            "minLength": 1,
            "description": "Mermaid source (flowchart, sequenceDiagram, etc.). Keep to 5–12 nodes."
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dark_deploy": {
          "type": "boolean"
        }
      }
    }
  }
}
