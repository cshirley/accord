{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task-schema.json",
  "title": "Per-task file v2 — requirement-centric trace + loop control",
  "description": "Read order = priority: header → summary (snapshot, recomputed on every write) → control (loop state for recovery) → requirements (AC → changes → findings → history → verification) → log. Orchestrator-owned; agents read it, never write it. See docs/plans/task-trace-ledger-plan.md.",
  "type": "object",
  "required": [
    "schema_version",
    "work_item",
    "task",
    "title",
    "plan",
    "spec",
    "summary",
    "control",
    "requirements",
    "log"
  ],
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "string",
      "pattern": "^[TCV]\\d+/[a-z-]+(\\.\\d+)?$",
      "description": "Log ref `<round>/<actor>`: round T<n> (test loop), C<n> (code loop), V<n> (verify); actor is an agent id or decision/harness/unblock/block/commit."
    },
    "severity": { "enum": ["critical", "warning", "suggestion"] },
    "findingState": {
      "enum": [
        "open",
        "addressed",
        "disputed",
        "wont_fix_proposed",
        "verified",
        "reraised",
        "dispute_upheld",
        "wont_fix_accepted",
        "waived",
        "superseded"
      ]
    },
    "retryCounter": {
      "type": "object",
      "required": ["used", "lifetime"],
      "additionalProperties": false,
      "properties": {
        "used": { "type": "integer", "minimum": 0 },
        "lifetime": {
          "type": "integer",
          "minimum": 0,
          "description": "Never reset by unblock."
        }
      }
    },
    "summaryItem": {
      "type": "object",
      "required": ["finding", "ac", "severity", "state", "issue"],
      "additionalProperties": false,
      "properties": {
        "finding": { "type": "string" },
        "ac": { "type": "string" },
        "severity": { "$ref": "#/definitions/severity" },
        "state": { "$ref": "#/definitions/findingState" },
        "issue": { "type": "string" }
      }
    },
    "change": {
      "type": "object",
      "required": ["file", "action", "kind", "by"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "action": { "enum": ["add", "modify", "delete"] },
        "kind": { "enum": ["test", "stub", "fixture", "config", "code", "dep"] },
        "by": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ref" },
          "description": "Runs that touched this file for this requirement, oldest first."
        },
        "tests": { "type": "array", "items": { "type": "string" } },
        "inferred": {
          "type": "boolean",
          "description": "Harness attributed the change (agent did not report changes[])."
        }
      }
    },
    "historyEntry": {
      "type": "object",
      "required": ["by", "outcome"],
      "additionalProperties": false,
      "properties": {
        "by": { "$ref": "#/definitions/ref" },
        "outcome": {
          "enum": [
            "fixed",
            "disputed",
            "wont_fix",
            "verified",
            "reraised",
            "dispute_upheld",
            "wont_fix_accepted",
            "waived",
            "note"
          ]
        },
        "note": { "type": "string" },
        "severity": { "$ref": "#/definitions/severity" },
        "actor": { "const": "human" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "state", "severity", "loop", "issue", "raised", "history"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^F-\\d+$" },
        "state": { "$ref": "#/definitions/findingState" },
        "severity": { "$ref": "#/definitions/severity" },
        "loop": {
          "enum": ["T", "C", "V"],
          "description": "Loop that owns resolution (T: phase-test/review-test; C: phase-code/raiser; V: phase-code/phase-verify-task)."
        },
        "advisory": {
          "type": "boolean",
          "description": "Below the gate or raised by review-security: shown, never blocks."
        },
        "tc": { "type": "string" },
        "also_affects": { "type": "array", "items": { "type": "string" } },
        "issue": { "type": "string", "minLength": 1 },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": { "type": "string" },
            "evidence": { "type": "string" },
            "recommendation": { "type": "string" }
          }
        },
        "raised": { "$ref": "#/definitions/ref" },
        "history": { "type": "array", "items": { "$ref": "#/definitions/historyEntry" } }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "text", "test_cases", "status", "changes", "findings", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(AC-\\d+|QF|_task)$" },
        "requirement": { "type": "string" },
        "text": { "type": "string" },
        "test_cases": { "type": "array", "items": { "type": "string" } },
        "status": {
          "enum": ["pending", "covered", "open", "implemented", "satisfied", "waived", "n/a"]
        },
        "changes": { "type": "array", "items": { "$ref": "#/definitions/change" } },
        "findings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
        "verification": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["by", "result", "tests"],
              "additionalProperties": false,
              "properties": {
                "by": { "$ref": "#/definitions/ref" },
                "result": { "enum": ["pass", "fail"] },
                "tests": { "type": "array", "items": { "type": "string" } },
                "command": { "type": "string" }
              }
            }
          ]
        },
        "waived": {
          "type": "object",
          "required": ["by", "reason"],
          "additionalProperties": false,
          "properties": {
            "by": { "$ref": "#/definitions/ref" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "logEntry": {
      "type": "object",
      "required": ["ref", "at", "result", "note"],
      "additionalProperties": false,
      "properties": {
        "ref": { "$ref": "#/definitions/ref" },
        "at": { "type": "string" },
        "result": { "type": "string" },
        "note": { "type": "string" },
        "actor": { "const": "human" },
        "next_phase": { "type": "string" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["escalation", "deviation", "request_review", "test_issue", "usage"]
              }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "2.0" },
    "work_item": { "type": "string", "pattern": "^[A-Z]+([_-][A-Z]+)*[_-]\\d+$" },
    "task": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "plan": { "type": ["string", "null"] },
    "spec": { "type": ["string", "null"] },
    "summary": {
      "type": "object",
      "required": ["headline", "updated", "requirements", "next", "blockers", "advisories"],
      "additionalProperties": false,
      "description": "Snapshot recomputed by the harness on every write — never hand-edit.",
      "properties": {
        "headline": { "type": "string" },
        "updated": { "type": "string" },
        "requirements": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "next": {
          "type": "object",
          "required": ["who", "why", "do"],
          "additionalProperties": false,
          "properties": {
            "who": { "enum": ["agent", "human", "harness", "none"] },
            "why": { "type": "string" },
            "do": { "type": "array", "items": { "type": "string" } }
          }
        },
        "blockers": { "type": "array", "items": { "$ref": "#/definitions/summaryItem" } },
        "advisories": { "type": "array", "items": { "$ref": "#/definitions/summaryItem" } }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "owner_nonce",
        "phase",
        "status",
        "pre_impl_gates",
        "round",
        "in_flight",
        "retries",
        "blocked",
        "test_files",
        "stub_files",
        "last_test_run"
      ],
      "additionalProperties": false,
      "description": "Loop state the harness needs to resume after a crash, lost packet, or fresh session.",
      "properties": {
        "owner_nonce": { "type": "string", "pattern": "^[0-9a-f]{6}$" },
        "phase": {
          "enum": [
            "phase-test",
            "review-test",
            "phase-code",
            "review-security",
            "review-code",
            "phase-verify-task"
          ]
        },
        "status": { "enum": ["pending", "in_progress", "blocked", "done"] },
        "pre_impl_gates": { "enum": ["pending", "complete"] },
        "round": { "type": "string", "pattern": "^[TCV]\\d+$" },
        "in_flight": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["ref", "agent", "stage", "at"],
              "additionalProperties": false,
              "properties": {
                "ref": { "$ref": "#/definitions/ref" },
                "agent": { "type": "string" },
                "stage": { "enum": ["spawned", "returned"] },
                "at": { "type": "string" }
              }
            }
          ]
        },
        "retries": {
          "type": "object",
          "required": ["test_review", "code_review", "rgr", "verify", "unblocks"],
          "additionalProperties": false,
          "properties": {
            "test_review": { "$ref": "#/definitions/retryCounter" },
            "code_review": { "$ref": "#/definitions/retryCounter" },
            "rgr": { "$ref": "#/definitions/retryCounter" },
            "verify": { "$ref": "#/definitions/retryCounter" },
            "unblocks": { "type": "integer", "minimum": 0 }
          }
        },
        "blocked": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "reason", "ref"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["cap", "crash", "manual", "stuck"] },
                "reason": { "type": "string" },
                "ref": { "$ref": "#/definitions/ref" },
                "loop": { "enum": ["T", "C", "V", "rgr"] },
                "lifetime": { "type": "boolean" },
                "fingerprint": { "type": "string" }
              }
            }
          ]
        },
        "test_files": { "type": "array", "items": { "type": "string" } },
        "stub_files": { "type": "array", "items": { "type": "string" } },
        "last_test_run": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["ref"],
              "additionalProperties": false,
              "properties": {
                "ref": { "$ref": "#/definitions/ref" },
                "red": { "enum": ["behaviour", "import_only", "crash", "unknown"] },
                "confirmed": { "type": "boolean" },
                "output": {
                  "type": "string",
                  "description": "Sidecar file name under .tasks/<ID>-task-<N>/"
                }
              }
            }
          ]
        },
        "quick_fix_contract": {
          "type": "object",
          "required": ["plan", "test"],
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "object",
              "required": ["summary", "target_paths", "out_of_scope", "expected_finish"],
              "additionalProperties": false,
              "properties": {
                "summary": { "type": "string", "minLength": 1 },
                "target_paths": { "type": "array", "items": { "type": "string" } },
                "out_of_scope": { "type": "array", "items": { "type": "string" } },
                "expected_finish": { "type": "string", "minLength": 1 }
              }
            },
            "test": {
              "type": "object",
              "required": ["strategy", "red_required"],
              "additionalProperties": false,
              "properties": {
                "strategy": { "enum": ["existing_tests", "new_red_test", "no_test"] },
                "command": { "type": "string", "minLength": 1 },
                "red_required": { "type": "boolean" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "requirements": { "type": "array", "items": { "$ref": "#/definitions/requirement" } },
    "log": { "type": "array", "items": { "$ref": "#/definitions/logEntry" } }
  }
}
