{
  "name": "@clive.shirley/pi-accord",
  "version": "0.1.0",
  "private": true,
  "description": "ACCORD harness — /dev command, tools, hooks, and orchestration",
  "keywords": [
    "pi-package"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src/",
    "assets/"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typebox": "^1.3.7"
  },
  "dependencies": {
    "@clive.shirley/accord-assets": "workspace:*",
    "@clive.shirley/accord-cli": "workspace:*",
    "@clive.shirley/accord-core": "workspace:*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "accord": {
    "assetManifest": "../accord-assets/manifest.json"
  }
}
