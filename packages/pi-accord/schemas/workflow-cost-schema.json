{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow-cost-schema.json",
  "title": "Workflow cost rollup",
  "description": "Checked-in token and estimated USD rollup for a work item (derived from .tasks/<ID>-usage.jsonl at finish).",
  "type": "object",
  "required": [
    "schema_version",
    "work_item_id",
    "generated_at",
    "source_usage_file",
    "summary",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "work_item_id": { "type": "string", "pattern": "^[A-Z]+(-[A-Z]+)*-\\d+$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "source_usage_file": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["total_input_tokens", "total_output_tokens", "total_cost_usd"],
      "additionalProperties": false,
      "properties": {
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "agent", "calls", "input_tokens", "output_tokens", "cost_usd"],
        "additionalProperties": false,
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "agent": { "type": "string", "minLength": 1 },
          "task_id": { "type": "integer", "minimum": 1 },
          "calls": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
