{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "return-schemas/phase-explore.json",
  "title": "phase-explore return packet",
  "type": "object",
  "required": ["status", "files", "symbols", "reuse_candidates", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["done", "stuck"] },
    "files": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string" }
    },
    "symbols": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["symbol", "file"],
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "reuse_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "file", "fit"],
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string" },
          "file": { "type": "string" },
          "fit": { "enum": ["use as-is", "extend", "compose with", "partial match only"] }
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
