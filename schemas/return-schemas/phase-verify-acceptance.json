{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "return-schemas/phase-verify-acceptance.json",
  "title": "phase-verify-acceptance return packet",
  "type": "object",
  "required": ["status", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["done", "stuck"] },
    "verdict": { "enum": ["pass", "gaps"] },
    "verify_path": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "partial", "not_verified"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "not_verified": { "type": "integer", "minimum": 0 }
      }
    },
    "question": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "tried": { "type": "string" },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "done" } },
        "required": ["status"]
      },
      "then": { "required": ["verdict", "verify_path", "summary"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "stuck" } },
        "required": ["status"]
      },
      "then": { "required": ["question", "context"] }
    }
  ]
}
