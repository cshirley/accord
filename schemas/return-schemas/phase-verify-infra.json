{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "return-schemas/phase-verify-infra.json",
  "title": "phase-verify-infra return packet",
  "type": "object",
  "required": ["status", "usage"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["done", "stuck"] },
    "valid": { "type": "boolean" },
    "preview": { "type": "string" },
    "resources": {
      "type": "object",
      "required": ["add", "change", "destroy"],
      "additionalProperties": false,
      "properties": {
        "add": { "type": "integer", "minimum": 0 },
        "change": { "type": "integer", "minimum": 0 },
        "destroy": { "type": "integer", "minimum": 0 }
      }
    },
    "iac_tool": {
      "enum": ["terraform", "helm", "pulumi", "cdk", "cloudformation"]
    },
    "question": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "tried": { "type": "string" },
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "done" } },
        "required": ["status"]
      },
      "then": { "required": ["valid", "preview", "resources", "iac_tool"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "stuck" } },
        "required": ["status"]
      },
      "then": { "required": ["question", "context"] }
    }
  ]
}
