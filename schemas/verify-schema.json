{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verify-schema.json",
  "title": "Verify report",
  "type": "object",
  "required": ["schema_version", "work_item_id", "date", "verdict", "criteria", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^[A-Z]+(-[A-Z]+)*-\\d+$"
    },
    "date": {
      "type": "string"
    },
    "verdict": {
      "enum": ["pass", "gaps"]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ac_id", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^AC-\\d+$"
          },
          "status": {
            "enum": ["pass", "fail", "partial", "not_verified"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type", "name"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": ["test", "file", "lint_rule", "command"]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "line_range": {
                      "type": "string",
                      "pattern": "^\\d+-\\d+$"
                    },
                    "run_log": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "Legacy shape — 'path:line — narrative' string. Prefer the object form. Kept for backwards compatibility; strict format is not enforced here because old artifacts use free-form prose."
                }
              ]
            }
          },
          "gap": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["fail", "partial"]
                }
              },
              "required": ["status"]
            },
            "then": {
              "required": ["gap", "suggested_action"]
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "partial", "not_verified"],
      "additionalProperties": false,
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "not_verified": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
