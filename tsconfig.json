{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun-types"],
    "paths": {
      "@clive.shirley/accord-core": ["packages/accord-core/src/index.ts"],
      "@clive.shirley/accord-core/*": ["packages/accord-core/src/*"],
      "@clive.shirley/accord-cli": ["packages/accord-cli/src/index.ts"],
      "@clive.shirley/accord-cli/*": ["packages/accord-cli/src/*"],
      "@clive.shirley/pi-accord": ["packages/pi-accord/src/index.ts"],
      "@clive.shirley/pi-accord/*": ["packages/pi-accord/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/pi-accord/scripts/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
